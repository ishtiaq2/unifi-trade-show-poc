// unifi-products-demo/src/monitoring-service/tsconfig.json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": [
    "index.ts",
    "clients",
    "config",
    "checksum",
    "domain",
    "http",
    "logging",
    "poller",
    "service",
    "datasource-module",
    "test"
  ]
}
